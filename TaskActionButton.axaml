<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskManagerApp"
             x:Class="TaskManagerApp.TaskActionButton"
             x:DataType="local:TaskActionButton">
    <Button x:Name="ActionButton"
            Content="{Binding Text, RelativeSource={RelativeSource AncestorType=local:TaskActionButton}}"
            Background="{Binding ButtonBackground, RelativeSource={RelativeSource AncestorType=local:TaskActionButton}}"
            Foreground="{Binding ButtonForeground, RelativeSource={RelativeSource AncestorType=local:TaskActionButton}}"
            Click="OnButtonClicked"
            Padding="12,6"
            Margin="4,0"
            CornerRadius="4"
            FontWeight="SemiBold"
            Cursor="Hand" />
</UserControl>
