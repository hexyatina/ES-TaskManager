<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskManagerApp"
             x:Class="TaskManagerApp.TaskCard"
             x:DataType="local:TaskItem">
    <Border Background="#F9F9FB"
            BorderBrush="{Binding StatusColor}"
            BorderThickness="1.5"
            CornerRadius="8"
            Padding="14,12"
            Margin="0,4">
        <Grid ColumnDefinitions="*, Auto">
            <!-- Інформація про завдання -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="{Binding Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Статус: " 
                               FontSize="13" 
                               Foreground="#666666" />
                    <TextBlock Text="{Binding StatusText}" 
                               FontSize="13" 
                               FontWeight="Bold"
                               Foreground="{Binding StatusColor}" />
                </StackPanel>
            </StackPanel>

            <!-- Дії над завданням через власний TaskActionButton -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                <local:TaskActionButton Text="{Binding StatusButtonText}"
                                        ButtonBackground="{Binding StatusActionBrush}"
                                        ActionClicked="OnToggleStatusClicked" />
                <local:TaskActionButton Text="Видалити"
                                        ButtonBackground="#D32F2F"
                                        ActionClicked="OnDeleteClicked" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
